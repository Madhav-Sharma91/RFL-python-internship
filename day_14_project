import matplotlib.pyplot as plt

# Data
categories = ["FOOD", "TRAVEL", "SHOPPING"]
expenses = [500, 300, 200]

# Find highest expense
max_value = max(expenses)
max_index = expenses.index(max_value)

# Explode highest category
explode = [0.1 if i == max_index else 0 for i in range(len(expenses))]

# Plot pie chart
plt.figure(figsize=(7,7))

plt.pie(
    expenses,
    labels=categories,
    autopct='%1.1f%%',
    explode=explode,
    shadow=True,
    startangle=90
)

# Title
plt.title("Category Breakdown of Expenses")

# Show chart
plt.show()
