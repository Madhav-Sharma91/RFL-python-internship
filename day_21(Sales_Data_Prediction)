        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -----------------------------\n",
        "# 1. LOAD DATA\n",
        "# -----------------------------\n",
        "df = pd.read_csv(\"Sales_data (1).csv\")\n",
        "\n",
        "print(\"\\nOriginal Data:\")\n",
        "print(df.head())\n",
        "print(df.columns.tolist())\n",
        "\n",
        "# Corrected column names in dropna and assigned back to df\n",
        "df = df.dropna(subset=[\n",
        "    \"order_date\",\n",
        "    \"customer\",\n",
        "    \"product_name\",\n",
        "    \"category\",\n",
        "    \"sales\",\n",
        "])\n",
        "# -----------------------------\n",
        "# 2. CLEAN DATA\n",
        "# -----------------------------\n",
        "print(\"\\nMissing Values:\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "df = df.drop_duplicates()\n",
        "\n",
        "# Corrected column names for type conversion, and creating new 'Date' and 'Sales' columns\n",
        "# to match the user's apparent intent for later use in grouping/calculations.\n",
        "df['Date'] = pd.to_datetime(df['order_date'])\n",
        "df['Sales'] = pd.to_numeric(df['sales'])\n",
        "\n",
        "# -----------------------------\n",
        "# 3. CALCULATIONS\n",
        "# -----------------------------\n",
        "total_sales = df[\"Sales\"].sum()\n",
        "average_revenue = df[\"Sales\"].mean()\n",
        "\n",
        "print(\"\\nTotal Sales:\", total_sales)\n",
        "print(\"Average Revenue:\", average_revenue)\n",
        "\n",
        "# -----------------------------\n",
        "# 4. TOP 5 CUSTOMERS\n",
        "# -----------------------------\n",
        "top_customers = (\n",
        "    df.groupby(\"customer\")[\"Sales\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        "    .head(5)\n",
        ")\n",
        "\n",
        "print(\"\\nTop 5 Customers:\")\n",
        "print(top_customers)\n",
        "\n",
        "# -----------------------------\n",
        "# 5. SALES TREND\n",
        "# -----------------------------\n",
        "daily_sales = df.groupby(\"Date\")[\"Sales\"].sum()\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(daily_sales.index, daily_sales.values, marker=\"o\")\n",
        "plt.title(\"Sales Trend\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Sales\")\n",
        "plt.xticks(rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"sales_trend.png\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# 6. TOP PRODUCTS\n",
        "# -----------------------------\n",
        "top_products = (\n",
        "    df.groupby(\"product_name\")[\"Sales\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "top_products.plot(kind=\"bar\")\n",
        "plt.title(\"Top Products by Sales\")\n",
        "plt.xlabel(\"Product\")\n",
        "plt.ylabel(\"Sales\")\n",
        "plt.xticks(rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"top_products.png\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# 7. CATEGORY DISTRIBUTION\n",
        "# -----------------------------\n",
        "category_sales = df.groupby(\"category\")[\"Sales\"].sum()\n",
        "\n",
        "plt.figure(figsize=(7, 7))\n",
        "category_sales.plot(\n",
        "    kind=\"pie\",\n",
        "    autopct=\"%1.1f%%\"\n",
        ")\n",
        "plt.title(\"Category Distribution\")\n",
        "plt.ylabel(\"\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"category_distribution.png\")\n",
        "plt.show()\n",
        "\n",
        "# -----------------------------\n",
        "# 8. SAVE REPORT\n",
        "# -----------------------------\n",
        "report = pd.DataFrame({\n",
        "    \"Metric\": [\"Total Sales\", \"Average Revenue\"],\n",
        "    \"Value\": [total_sales, average_revenue]\n",
        "})\n",
        "\n",
        "report.to_csv(\"sales_report.csv\", index=False)\n",
        "top_customers.to_csv(\"top_5_customers.csv\")\n",
        "\n",
        "print(\"\\nProject completed successfully!\")"
      ]
