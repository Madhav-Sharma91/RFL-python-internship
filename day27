      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import re\n",
        "\n",
        "# ==========================================\n",
        "# Configuration\n",
        "# ==========================================\n",
        "import pandas as pd\n",
        "\n",
        "data = {\n",
        "    \"PostID\": [\n",
        "        \"P001\", \"P002\", \"P003\", \"P004\",\n",
        "        \"P005\", \"P006\", \"P007\", \"P008\"\n",
        "    ],\n",
        "\n",
        "    \"User\": [\n",
        "        \"alice\", \"bob\", \"alice\", \"charlie\",\n",
        "        \"bob\", \"alice\", \"charlie\", \"bob\"\n",
        "    ],\n",
        "\n",
        "    \"Date\": [\n",
        "        \"2026-08-01\", \"2026-08-01\", \"2026-08-01\",\n",
        "        \"2026-08-02\", \"2026-08-02\", \"2026-08-03\",\n",
        "        \"2026-08-03\", \"2026-08-04\"\n",
        "    ],\n",
        "\n",
        "    \"Time\": [\n",
        "        \"09:30\", \"14:00\", \"18:30\", \"10:00\",\n",
        "        \"20:00\", \"19:00\", \"12:00\", \"21:00\"\n",
        "    ],\n",
        "\n",
        "    \"Hashtags\": [\n",
        "        \"#Python #Coding\",\n",
        "        \"#Travel #Vacation\",\n",
        "        \"#Python #AI\",\n",
        "        \"#Food #Cooking\",\n",
        "        \"#Fitness #Health\",\n",
        "        \"#AI #Technology\",\n",
        "        \"#Food #Recipe\",\n",
        "        \"#Travel #Adventure\"\n",
        "    ],\n",
        "\n",
        "    \"ContentCategory\": [\n",
        "        \"Technology\",\n",
        "        \"Travel\",\n",
        "        \"Technology\",\n",
        "        \"Food\",\n",
        "        \"Fitness\",\n",
        "        \"Technology\",\n",
        "        \"Food\",\n",
        "        \"Travel\"\n",
        "    ],\n",
        "\n",
        "    \"Likes\": [\n",
        "        120, 250, 500, 180,\n",
        "        300, 450, 220, 350\n",
        "    ],\n",
        "\n",
        "    \"Comments\": [\n",
        "        20, 35, 80, 25,\n",
        "        40, 70, 30, 45\n",
        "    ],\n",
        "\n",
        "    \"Shares\": [\n",
        "        15, 40, 100, 30,\n",
        "        50, 90, 25, 70\n",
        "    ],\n",
        "\n",
        "    \"Text\": [\n",
        "        \"Learning Python today!\",\n",
        "        \"Amazing trip!\",\n",
        "        \"AI and Python are amazing!\",\n",
        "        \"Delicious homemade food\",\n",
        "        \"Great workout today!\",\n",
        "        \"The future of AI is exciting!\",\n",
        "        \"This recipe turned out great!\",\n",
        "        \"What an incredible adventure!\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Save CSV file\n",
        "df.to_csv(\"social_media_data.csv\", index=False)\n",
        "\n",
        "print(\"CSV file created successfully!\")\n",
        "print(\"File name: social_media_data.csv\")\n",
        "print(\"\\nData:\")\n",
        "print(df)\n",
        "\n",
        "INPUT_FILE = \"social_media_data.csv\"\n",
        "REPORT_FILE = \"analytics_report.csv\"\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 1. Read CSV\n",
        "# ==========================================\n",
        "\n",
        "df = pd.read_csv(INPUT_FILE)\n",
        "\n",
        "df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n",
        "\n",
        "print(\"Social media data loaded successfully!\")\n",
        "print(\"\\nFirst 5 records:\")\n",
        "print(df.head())\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. Calculate Engagement\n",
        "# ==========================================\n",
        "\n",
        "df[\"Engagement\"] = (\n",
        "    df[\"Likes\"] +\n",
        "    df[\"Comments\"] +\n",
        "    df[\"Shares\"]\n",
        ")\n",
        "\n",
        "print(\"\\nTotal Engagement:\")\n",
        "print(df[\"Engagement\"].sum())\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. Extract Hashtags\n",
        "# ==========================================\n",
        "\n",
        "def extract_hashtags(text):\n",
        "    if pd.isna(text):\n",
        "        return []\n",
        "\n",
        "    return re.findall(\n",
        "        r\"#\\w+\",\n",
        "        str(text).lower()\n",
        "    )\n",
        "\n",
        "\n",
        "# Extract hashtags from Hashtags column\n",
        "df[\"HashtagList\"] = df[\"Hashtags\"].apply(\n",
        "    extract_hashtags\n",
        ")\n",
        "\n",
        "\n",
        "# Flatten hashtag lists\n",
        "all_hashtags = []\n",
        "\n",
        "for hashtags in df[\"HashtagList\"]:\n",
        "    all_hashtags.extend(hashtags)\n",
        "\n",
        "\n",
        "hashtag_counts = (\n",
        "    pd.Series(all_hashtags)\n",
        "    .value_counts()\n",
        ")\n",
        "\n",
        "print(\"\\nTop Trending Hashtags:\")\n",
        "print(hashtag_counts.head(10))\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 4. Most Active Users\n",
        "# ==========================================\n",
        "\n",
        "active_users = (\n",
        "    df[\"User\"]\n",
        "    .value_counts()\n",
        ")\n",
        "\n",
        "print(\"\\nMost Active Users:\")\n",
        "print(active_users.head(10))\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 5. Most Popular Posting Time\n",
        "# ==========================================\n",
        "\n",
        "df[\"Hour\"] = pd.to_datetime(\n",
        "    df[\"Time\"],\n",
        "    format=\"%H:%M\"\n",
        ").dt.hour\n",
        "\n",
        "popular_hour = (\n",
        "    df[\"Hour\"]\n",
        "    .value_counts()\n",
        "    .idxmax()\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nMost popular posting hour: {popular_hour}:00\"\n",
        ")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 6. Daily Engagement\n",
        "# ==========================================\n",
        "\n",
        "daily_engagement = (\n",
        "    df.groupby(\"Date\")[\"Engagement\"]\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "print(\"\\nDaily Engagement:\")\n",
        "print(daily_engagement)\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 7. Sentiment Analysis\n",
        "# ==========================================\n",
        "\n",
        "positive_words = [\n",
        "    \"good\", \"great\", \"amazing\",\n",
        "    \"excellent\", \"happy\", \"love\",\n",
        "    \"awesome\", \"fantastic\",\n",
        "    \"exciting\", \"wonderful\"\n",
        "]\n",
        "\n",
        "negative_words = [\n",
        "    \"bad\", \"terrible\", \"sad\",\n",
        "    \"hate\", \"awful\", \"poor\",\n",
        "    \"worst\", \"angry\",\n",
        "    \"boring\", \"disappointed\"\n",
        "]\n",
        "\n",
        "\n",
        "def sentiment_analysis(text):\n",
        "\n",
        "    text = str(text).lower()\n",
        "\n",
        "    positive_score = sum(\n",
        "        word in text\n",
        "        for word in positive_words\n",
        "    )\n",
        "\n",
        "    negative_score = sum(\n",
        "        word in text\n",
        "        for word in negative_words\n",
        "    )\n",
        "\n",
        "    if positive_score > negative_score:\n",
        "        return \"Positive\"\n",
        "\n",
        "    elif negative_score > positive_score:\n",
        "        return \"Negative\"\n",
        "\n",
        "    return \"Neutral\"\n",
        "\n",
        "\n",
        "df[\"Sentiment\"] = df[\"Text\"].apply(\n",
        "    sentiment_analysis\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nSentiment Distribution:\")\n",
        "print(df[\"Sentiment\"].value_counts())\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 8. Top Hashtags Chart\n",
        "# ==========================================\n",
        "\n",
        "top_hashtags = hashtag_counts.head(10)\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "top_hashtags.sort_values().plot(\n",
        "    kind=\"barh\",\n",
        "    color=\"purple\"\n",
        ")\n",
        "\n",
        "plt.title(\"📊 Top 10 Trending Hashtags\")\n",
        "plt.xlabel(\"Number of Posts\")\n",
        "plt.ylabel(\"Hashtag\")\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.savefig(\"top_hashtags.png\")\n",
        "plt.close()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 9. Daily Engagement Trend\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "daily_engagement.plot(\n",
        "    kind=\"line\",\n",
        "    marker=\"o\",\n",
        "    color=\"green\"\n",
        ")\n",
        "\n",
        "plt.title(\"📈 Daily Engagement Trend\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Engagement\")\n",
        "\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.savefig(\"daily_engagement.png\")\n",
        "plt.close()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 10. Content Category Distribution\n",
        "# ==========================================\n",
        "\n",
        "category_counts = (\n",
        "    df[\"ContentCategory\"]\n",
        "    .value_counts()\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(8, 8))\n",
        "\n",
        "category_counts.plot(\n",
        "    kind=\"pie\",\n",
        "    autopct=\"%1.1f%%\",\n",
        "    startangle=90\n",
        ")\n",
        "\n",
        "plt.title(\"🥧 Content Category Distribution\")\n",
        "plt.ylabel(\"\")\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.savefig(\"category_distribution.png\")\n",
        "plt.close()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 11. Generate Analytics Report\n",
        "# ==========================================\n",
        "\n",
        "# Create summary for each user\n",
        "user_summary = (\n",
        "    df.groupby(\"User\")\n",
        "    .agg(\n",
        "        Posts=(\"PostID\", \"count\"),\n",
        "        TotalLikes=(\"Likes\", \"sum\"),\n",
        "        TotalComments=(\"Comments\", \"sum\"),\n",
        "        TotalShares=(\"Shares\", \"sum\"),\n",
        "        TotalEngagement=(\"Engagement\", \"sum\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "\n",
        "# Save user-level analytics\n",
        "user_summary.to_csv(\n",
        "    REPORT_FILE,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nAnalytics report exported to {REPORT_FILE}\"\n",
        ")\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 12. Final Summary\n",
        "# ==========================================\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\"       SOCIAL MEDIA SUMMARY\")\n",
        "print(\"===================================\")\n",
        "\n",
        "print(\"Total Posts:\", len(df))\n",
        "\n",
        "print(\n",
        "    \"Total Likes:\",\n",
        "    df[\"Likes\"].sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Total Comments:\",\n",
        "    df[\"Comments\"].sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Total Shares:\",\n",
        "    df[\"Shares\"].sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Total Engagement:\",\n",
        "    df[\"Engagement\"].sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Most Active User:\",\n",
        "    active_users.idxmax()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Most Popular Posting Hour:\",\n",
        "    f\"{popular_hour}:00\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Top Hashtag:\",\n",
        "    hashtag_counts.index[0]\n",
        ")\n",
        "\n",
        "print(\"===================================\")\n"
