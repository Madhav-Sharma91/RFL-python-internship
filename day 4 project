# Simple Log Analyzer

# Given logs
logs = [
    "ERROR DISK FULL",
    "INFO STARTED",
    "ERROR FILE MISSING",
    "WARNING MEMORY LOW"
]

# Counters
error_count = 0
info_count = 0
warning_count = 0

# Count log types (ignore case sensitivity)
for log in logs:
    log = log.upper()

    if log.startswith("ERROR"):
        error_count += 1
    elif log.startswith("INFO"):
        info_count += 1
    elif log.startswith("WARNING"):
        warning_count += 1

# Store counts in dictionary
log_counts = {
    "ERROR": error_count,
    "INFO": info_count,
    "WARNING": warning_count
}

# Find most frequent log type
most_frequent = max(log_counts, key=log_counts.get)

# Output
print("ERROR Count:", error_count)
print("INFO Count:", info_count)
print("WARNING Count:", warning_count)

print("\nMost Frequent Log Type:", most_frequent)
