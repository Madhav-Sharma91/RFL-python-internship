import pandas as pd

# Create dataset
data = {
    'Product': ['A', 'B', 'A', 'C'],
    'Quantity': [2, 1, 3, 5],
    'Price': [100, 200, 100, 50]
}

# Convert to DataFrame
df = pd.DataFrame(data)

# Add new column: TOTAL = QUANTITY * PRICE
df['Total'] = df['Quantity'] * df['Price']

# Calculate total sales per product
sales_per_product = df.groupby('Product')['Total'].sum().reset_index()

# Find total revenue
total_revenue = sales_per_product['Total'].sum()

# Find top‑selling product
top_product = sales_per_product.loc[sales_per_product['Total'].idxmax(), 'Product']

# Sort by revenue
sorted_sales = sales_per_product.sort_values(by='Total', ascending=False)

# Display results
print("Sales per product:\n", sorted_sales)
print("\nTotal Revenue:", total_revenue)
print("Top‑Selling Product:", top_product)
